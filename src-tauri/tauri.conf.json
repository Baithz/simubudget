{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimuBudget",
  "version": "1.9.0",
  "identifier": "fr.simubudget.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com https://github.com https://objects.githubusercontent.com https://releases.githubusercontent.com; img-src 'self' asset: data:; font-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "SimuBudget",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KREMER Régis",
    "copyright": "Copyright © 2026 KREMER Régis. Tous droits réservés.",
    "category": "Finance",
    "shortDescription": "Copilote financier personnel local.",
    "longDescription": "SimuBudget est une application Windows locale pour simuler, piloter et anticiper sa vie financière.",
    "licenseFile": "LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "SimuBudget"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Baithz/simubudget/releases/latest/download/latest.json"],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
