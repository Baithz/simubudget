    "clsx": "^2.1.0",
    "dayjs": "^1.11.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "framer-motion": "^11.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
